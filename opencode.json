{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "sequentialthinking": {
      "type": "local",
      "command": ["mcp-server-sequential-thinking"],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["mcp-server-memory"],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": [
        "mcp-server-filesystem",
        "/mnt/data/projects/CloudToLocalLLM"
      ],
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": ["mcp-server-fetch"],
      "enabled": true
    },
    "git": {
      "type": "local",
      "command": [
        "mcp-server-git",
        "--repository",
        "/mnt/data/projects/CloudToLocalLLM"
      ],
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "oauth": {}
    }
  }
}
