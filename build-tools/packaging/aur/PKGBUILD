# Maintainer: Christopher Maltais <christopher.maltais@gmail.com>
pkgname=zoidbot
pkgver=VERSION
pkgrel=1
pkgdesc="Manage and run powerful Large Language Models locally, orchestrated via a cloud interface"
arch=('x86_64')
url="https://github.com/Zoidbot-online/Zoidbot"
license=('MIT')
depends=(
    'libayatana-appindicator'
    'gtk3'
    'glib2'
    'libsecret'
    'curl'
    'wmctrl'
    'xdg-utils'
)
provides=('zoidbot')
conflicts=('zoidbot-git' 'zoidbot-bin')
source=("https://github.com/Zoidbot-online/Zoidbot/releases/download/v${pkgver}/Zoidbot-Linux-x64.tar.gz")
sha256sums=('SKIP')

package() {
    # Install the application files
    install -dm755 "${pkgdir}/opt/zoidbot"
    cp -r "${srcdir}/zoidbot/"* "${pkgdir}/opt/zoidbot/"

    # Create /usr/bin wrapper
    install -dm755 "${pkgdir}/usr/bin"
    cat > "${pkgdir}/usr/bin/zoidbot" << EOF
#!/bin/bash
cd /opt/zoidbot
exec ./zoidbot "\$@"
EOF
    chmod +x "${pkgdir}/usr/bin/zoidbot"

    # Install desktop entry
    install -dm755 "${pkgdir}/usr/share/applications"
    cat > "${pkgdir}/usr/share/applications/zoidbot.desktop" << EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=Zoidbot
GenericName=AI Model Bridge
Comment=Manage and run powerful Large Language Models locally
Icon=zoidbot
Exec=zoidbot %u
Terminal=false
Categories=Development;Utility;Network;
Keywords=AI;LLM;Ollama;OpenAI;Machine Learning;
StartupNotify=true
StartupWMClass=Zoidbot
MimeType=x-scheme-handler/zoidbot;
EOF

    # Install icon
    install -dm755 "${pkgdir}/usr/share/pixmaps"
    if [ -f "${srcdir}/data/flutter_assets/assets/images/icon.png" ]; then
        install -m644 "${srcdir}/data/flutter_assets/assets/images/icon.png" "${pkgdir}/usr/share/pixmaps/zoidbot.png"
    fi
}
