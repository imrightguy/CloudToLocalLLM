{
  "name": "cloudtolocalllm-backend",
  "version": "10.1.187",
  "description": "Backend services for CloudToLocalLLM",
  "main": "services/api-backend/server.js",
  "type": "module",
  "scripts": {
    "start": "node services/api-backend/server.js",
    "dev": "nodemon services/api-backend/server.js",
    "lint": "for d in services/api-backend services/streaming-proxy services/sdk; do echo \"\\n--- Linting $d ---\" && (cd $d && npm run lint) || true; done",
    "format": "for d in services/api-backend services/streaming-proxy services/sdk; do (cd $d && npm run format 2>/dev/null) || true; done; prettier --write 'test/**/*.js'",
    "test": "NODE_ENV=test BYPASS_AUTH=*** node --experimental-vm-modules ./node_modules/jest/bin/jest.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1028.0",
    "@aws-sdk/client-cost-explorer": "^3.1028.0",
    "@modelcontextprotocol/sdk": "^1.24.3",
    "@playwright/test": "^1.56.1",
    "axios": "^1.13.5",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "express-oauth2-jwt-bearer": "^1.8.0",
    "express-rate-limit": "^8.2.1",
    "ioredis": "^5.9.2",
    "js-yaml": "^4.1.1",
    "jwks-rsa": "^3.2.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.1",
    "pg": "^8.18.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.3.1",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "fast-check": "^4.5.3",
    "jest": "^29.7.0",
    "jsonwebtoken": "^9.0.2",
    "nodemon": "^3.0.1",
    "prettier": "^3.8.2",
    "supertest": "^7.2.2"
  }
}
