{
  "_comment": "Copy this file to config.json and update with your actual credentials",
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_TOKEN": "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
      },
      "_notes": "Create a token at https://github.com/settings/tokens with repo, workflow permissions"
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://username:password@localhost:5432/cloudtolocallm"
      ],
      "_notes": "Get credentials from services/api-backend/.env file"
    },
    "docker": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-docker"
      ],
      "_notes": "Requires Docker to be running and user in docker group"
    },
    "fetch": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-fetch"
      ],
      "_notes": "For making HTTP requests to test APIs"
    },
    "puppeteer": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ],
      "_notes": "For browser automation and testing web builds"
    },
    "brave-search": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-brave-search"
      ],
      "_notes": "For web search and documentation lookup"
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/mnt/data/dev/CloudToLocalLLM"
      ],
      "_notes": "For file operations - update path to your project root"
    }
  },
  "env": {
    "PROJECT_ROOT": "/mnt/data/dev/CloudToLocalLLM",
    "API_BACKEND_PATH": "/mnt/data/dev/CloudToLocalLLM/services/api-backend",
    "SDK_PATH": "/mnt/data/dev/CloudToLocalLLM/services/sdk",
    "STREAMING_PROXY_PATH": "/mnt/data/dev/CloudToLocalLLM/services/streaming-proxy",
    "_notes": "Update these paths to match your project location"
  }
}
