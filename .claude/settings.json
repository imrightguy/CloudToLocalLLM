{
  "permissions": {
    "allow": [
      "Bash(gh api:*)",
      "Bash(for:*)",
      "Bash(do:*)",
      "Bash(echo:*)",
      "Bash(done)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(ls:*)",
      "Bash(jq:*)",
      "Bash(gh diff:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(find:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(gh pr list:*)",
      "Bash(flutter format:*)",
      "Bash(flutter analyze:*)",
      "Bash(cd:*)",
      "Bash(npm run format:*)",
      "Bash(npm run lint:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": {
          "tools": ["EditTool"]
        },
        "hooks": [
          {
            "type": "command",
            "command": "flutter format {{_arg0}}",
            "background": true,
            "condition": "{{_arg0}} matches lib/**/*.dart"
          }
        ]
      },
      {
        "matcher": {
          "tools": ["WriteTool"]
        },
        "hooks": [
          {
            "type": "command",
            "command": "flutter format {{_arg0}}",
            "background": true,
            "condition": "{{_arg0}} matches lib/**/*.dart"
          }
        ]
      },
      {
        "matcher": {
          "tools": ["EditTool"]
        },
        "hooks": [
          {
            "type": "command",
            "command": "cd services/api-backend && npm run format",
            "background": true,
            "condition": "{{_arg0}} matches services/api-backend/**/*.js"
          }
        ]
      },
      {
        "matcher": {
          "tools": ["WriteTool"]
        },
        "hooks": [
          {
            "type": "command",
            "command": "cd services/api-backend && npm run format",
            "background": true,
            "condition": "{{_arg0}} matches services/api-backend/**/*.js"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": {
          "tools": ["EditTool", "WriteTool"]
        },
        "hooks": [
          {
            "type": "block",
            "description": "Blocking edit to Kubernetes secret file",
            "condition": "{{_arg0}} matches **/*.secret.yaml"
          }
        ]
      },
      {
        "matcher": {
          "tools": ["EditTool", "WriteTool"]
        },
        "hooks": [
          {
            "type": "block",
            "description": "Blocking edit to production environment file",
            "condition": "{{_arg0}} matches **/.env.production"
          }
        ]
      },
      {
        "matcher": {
          "tools": ["EditTool", "WriteTool"]
        },
        "hooks": [
          {
            "type": "block",
            "description": "Blocking edit to environment file with warning",
            "condition": "{{_arg0}} matches **/.env"
          }
        ]
      },
      {
        "matcher": {
          "tools": ["EditTool", "WriteTool"]
        },
        "hooks": [
          {
            "type": "block",
            "description": "Blocking edit to secrets directory",
            "condition": "{{_arg0}} matches **/secrets/**"
          }
        ]
      },
      {
        "matcher": {
          "tools": ["EditTool", "WriteTool"]
        },
        "hooks": [
          {
            "type": "block",
            "description": "Blocking edit to private key files",
            "condition": "{{_arg0}} matches **/*.key"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-context7"
      ]
    },
    "sentry": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@latest",
        "https://mcp.sentry.dev/mcp"
      ]
    }
  }
}
