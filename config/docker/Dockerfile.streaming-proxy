# ============================================================================
# Runtime Dockerfile for CloudToLocalLLM Streaming Proxy
# Uses artifacts from the Universal Builder
# ============================================================================

# Use custom base image
ARG BASE_REGISTRY=cloudtolocalllm
FROM ${BASE_REGISTRY}/base:latest

# Switch to root to ensure directory setup
USER root

# Ensure Node.js and npm are installed (fallback if base image is missing them)
RUN if ! command -v npm &> /dev/null; then \
    apt-get update && apt-get install -y curl && \
    curl -fsSL https://deb.nodesource.com/setup_24.x | bash - && \
    apt-get install -y nodejs; \
    fi

# Create app directory
WORKDIR /app
RUN chown cloudtolocalllm:cloudtolocalllm /app

# Switch to non-root user
USER cloudtolocalllm

# Copy package files
COPY --chown=cloudtolocalllm:cloudtolocalllm services/streaming-proxy/package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY --chown=cloudtolocalllm:cloudtolocalllm services/streaming-proxy/ .

# Build TypeScript
RUN npm run build

# Set environment variables
ENV NODE_ENV=production
ENV PORT=3001

EXPOSE 3001

# Start the actual server (compiled JS)
CMD [ "node", "dist/server.js" ]
