# ============================================================================
# Runtime Dockerfile for CloudToLocalLLM Streaming Proxy
# Uses standard Node.js Alpine images
# ============================================================================

FROM node:24-alpine AS builder

WORKDIR /app

COPY services/streaming-proxy/package*.json ./
RUN npm ci

COPY services/streaming-proxy/ ./
RUN npm run build

FROM node:24-alpine

WORKDIR /app

RUN addgroup -g 1000 -S nodejs && \
    adduser -S -D -H -u 1000 -h /app -s /bin/sh -G nodejs -g nodejs nodejs

COPY services/streaming-proxy/package*.json ./
RUN npm ci --omit=dev

COPY --from=builder /app/dist ./dist

USER nodejs

ENV NODE_ENV=production
ENV PORT=3001

EXPOSE 3001

CMD ["node", "dist/server.js"]
