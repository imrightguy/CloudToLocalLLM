# Dockerfile for KiloCode CLI
# Provides a consistent Node.js environment for running code analysis

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Install Node.js 24
RUN apt-get update && \
    apt-get install -y curl ca-certificates gnupg && \
    mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_24.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list && \
    apt-get update && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Copy the KiloCode CLI script
COPY scripts/kilocode-cli.cjs /usr/local/bin/kilocode-cli.cjs

# Make executable
RUN chmod +x /usr/local/bin/kilocode-cli.cjs

# Set entrypoint
ENTRYPOINT ["node", "/usr/local/bin/kilocode-cli.cjs"]