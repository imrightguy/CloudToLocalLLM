# ============================================================================
# Single-stage Dockerfile for CloudToLocalLLM Web Application
# Expects pre-compiled Flutter web assets in build/web/
# ============================================================================

FROM nginx:1.27-alpine

USER root

# Create cloudtolocalllm user with UID 1001
RUN addgroup -g 1001 -S cloudtolocalllm && \
    adduser -S -D -H -u 1001 -h /usr/share/nginx/html -s /bin/sh -G cloudtolocalllm -g cloudtolocalllm cloudtolocalllm

# Copy main config
COPY config/docker/nginx.conf /etc/nginx/nginx.conf
# Copy site config
COPY config/docker/nginx-web.conf /etc/nginx/conf.d/default.conf

# Copy assets
COPY build/web /usr/share/nginx/html

# Fix permissions for non-root execution (using cloudtolocalllm:1001)
RUN chown -R cloudtolocalllm:cloudtolocalllm /usr/share/nginx/html /var/cache/nginx /var/log/nginx /etc/nginx/conf.d

USER cloudtolocalllm

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
