# ============================================================================
# Multi-stage Dockerfile for CloudToLocalLLM Web Application
# Stage 1: Build Flutter web application (using pre-built Flutter image)
# Stage 2: Serve with nginx (on Ubuntu base)
# ============================================================================

# ---- Stage 1: Build Flutter Web App ----
FROM ghcr.io/cirruslabs/flutter:stable AS builder

# Fix Flutter SDK ownership and permissions (must be done as root)
RUN chown -R 1000:1000 /sdks/flutter && \
    chmod -R u+w /sdks/flutter

# Fix Git safe directory
RUN git config --global --add safe.directory /sdks/flutter

# Create app directory and fix ownership
WORKDIR /app
RUN mkdir -p /app && \
    chown -R 1000:1000 /app

# Switch to non-root user
USER 1000

# Build argument to bust cache when code changes
ARG BUILD_SHA
ENV BUILD_SHA=${BUILD_SHA}

# Copy source code from build context
COPY --chown=1000:1000 . .

# Clean previous build artifacts
RUN flutter clean

# Get dependencies
RUN flutter pub get

# Build Flutter web app
RUN flutter build web --release

# ---- Stage 2: Serve with Nginx (Ubuntu Base) ----
ARG BASE_REGISTRY=cloudtolocalllm
FROM ${BASE_REGISTRY}/base:latest

USER root

# Install Nginx
RUN apt-get update && \
    apt-get install -y nginx && \
    rm -rf /var/lib/apt/lists/* && \
    chown -R cloudtolocalllm:cloudtolocalllm /var/www/html && \
    chown -R cloudtolocalllm:cloudtolocalllm /var/log/nginx && \
    chown -R cloudtolocalllm:cloudtolocalllm /var/lib/nginx && \
    chown -R cloudtolocalllm:cloudtolocalllm /etc/nginx/conf.d

# Copy custom nginx configuration
COPY config/docker/nginx-web.conf /etc/nginx/conf.d/default.conf
COPY config/docker/nginx.conf /etc/nginx/nginx.conf

# Copy built Flutter web app from builder stage
COPY --from=builder --chown=cloudtolocalllm:cloudtolocalllm /app/build/web /var/www/html

# Forward request and error logs to docker log collector
RUN ln -sf /dev/stdout /var/log/nginx/access.log \
    && ln -sf /dev/stderr /var/log/nginx/error.log

# Switch to non-root user
USER cloudtolocalllm

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
