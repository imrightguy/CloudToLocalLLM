# ============================================================================
# Single-stage Dockerfile for CloudToLocalLLM Web Application
# Expects pre-compiled Flutter web assets in build/web/
# ============================================================================

FROM nginx:1.27-alpine

USER root

# Copy main config
COPY config/docker/nginx.conf /etc/nginx/nginx.conf
# Copy site config
COPY config/docker/nginx-web.conf /etc/nginx/conf.d/default.conf

# Copy assets
COPY build/web /usr/share/nginx/html

# Fix permissions for non-root execution
RUN chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/log/nginx /etc/nginx/conf.d

USER nginx

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
