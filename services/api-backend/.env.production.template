# ── ImmoGestion Production Environment ────────────────────────────────
# Copy this to .env.production and fill in the values
# NEVER commit the real .env.production file
# ──────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────
# These are used by both docker-compose (postgres service) and the API.
# Generate a strong password: openssl rand -base64 32
DB_USER=postgres
DB_PASSWORD=<GENER...ORD>
# The API needs a full connection URL. Use "postgres" as hostname
# (the Docker service name), not "localhost".
# postgres://postgres:***@postgres:5432/immogestion
DATABASE_URL=postgres://postgres:***@postgres:5432/immogestion

# ── JWT ───────────────────────────────────────────────────────────────
# Generate secrets: openssl rand -base64 48
JWT_SECRET=<GENER...RET>
JWT_REFRESH_SECRET=<GENER...RET>
JWT_EXPIRES_IN=24h

# ── App URLs ──────────────────────────────────────────────────────────
APP_URL=https://app.immogestion.app
PUBLIC_URL=https://api.immogestion.app
ALLOWED_ORIGINS=https://immogestion.app,https://app.immogestion.app,https://api.immogestion.app

# ── Twilio (SMS notifications) ────────────────────────────────────────
# Get these from Simon or the Twilio console
TWILIO_ACCOUNT_SID=<YOUR_TWILIO_ACCOUNT_SID>
TWILIO_AUTH_TOKEN=<YOUR_TWILIO_AUTH_TOKEN>
TWILIO_PHONE_NUMBER=<YOUR_TWILIO_PHONE_NUMBER>
SIMON_PHONE=<SIMON_S_PHONE_NUMBER>

# ── Facebook Messenger / Lead Ads ─────────────────────────────────────
# Needed for Meta webhook verification + page messaging
FB_VERIFY_TOKEN=<YOUR_FACEBOOK_VERIFY_TOKEN>
FB_PAGE_ACCESS_TOKEN=<YOUR_FACEBOOK_PAGE_ACCESS_TOKEN>

# ── Email (SMTP) ─────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@immogestion.ca

# ── Public API Base for confirmation links ───────────────────────────
PAPERCLIP_PUBLIC_URL=https://api.immogestion.app

# ── Security ─────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Cloudflare Tunnel (used by docker-compose tunnel service) ────────
# Get this from Cloudflare Zero Trust dashboard after creating a tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
