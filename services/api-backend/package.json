{
  "name": "immogestion-api",
  "version": "1.0.0",
  "description": "Quebec leasing automation engine API backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "migrate": "node -r dotenv/config scripts/migrate.js",
    "seed": "node -r dotenv/config scripts/seed.js",
    "build": "echo 'No build step required for Node.js'"
  },
  "keywords": [
    "immogestion",
    "real-estate",
    "leasing",
    "quebec",
    "api",
    "automation"
  ],
  "author": "Christopher Maltais",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.4.1",
    "drizzle-orm": "^0.28.5",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.5",
    "pg": "^8.11.3",
    "postgres": "^3.4.3",
    "sharp": "^0.32.4",
    "twilio": "^4.17.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.19.3",
    "eslint": "^8.47.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.28.1",
    "jest": "^29.6.2",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/imrightguy/ImmoGestion.git"
  },
  "bugs": {
    "url": "https://github.com/imrightguy/ImmoGestion/issues"
  },
  "homepage": "https://github.com/imrightguy/ImmoGestion#readme"
}
