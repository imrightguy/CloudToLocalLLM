{
  "name": "immogestion-api",
  "version": "1.0.42",
  "description": "Quebec leasing automation engine API backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "LOG_LEVEL=silent jest --forceExit --testPathIgnorePatterns='integration'",
    "test:watch": "jest --watch",
    "test:integration": "bash ./scripts/run-integration-tests.sh",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "migrate": "node -r dotenv/config scripts/migrate.js",
    "seed": "node -r dotenv/config scripts/seed-demo.js",
    "seed:clear": "node -r dotenv/config scripts/seed-demo.js --clear",
    "build": "echo 'No build step required for Node.js'"
  },
  "keywords": [
    "immogestion",
    "real-estate",
    "leasing",
    "quebec",
    "api",
    "automation"
  ],
  "author": "Christopher Maltais",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.1",
    "express-rate-limit": "^6.11.2",
    "formidable": "^3.5.4",
    "helmet": "^7.2.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.5",
    "pg": "^8.20.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^4.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "globals": "^17.5.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^6.3.4"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/imrightguy/ImmoGestion.git"
  },
  "bugs": {
    "url": "https://github.com/imrightguy/ImmoGestion/issues"
  },
  "homepage": "https://github.com/imrightguy/ImmoGestion#readme"
}
