{
  "name": "immogestion-api",
  "version": "1.0.0",
  "description": "Quebec leasing automation engine API backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "LOG_LEVEL=silent jest --forceExit --testPathIgnorePatterns='integration'",
    "test:watch": "jest --watch",
    "test:integration": "LOG_LEVEL=silent jest __tests__/integration/ --forceExit --runInBand",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "migrate": "node -r dotenv/config scripts/migrate.js",
    "seed": "node -r dotenv/config scripts/seed-demo.js",
    "seed:clear": "node -r dotenv/config scripts/seed-demo.js --clear",
    "build": "echo 'No build step required for Node.js'"
  },
  "keywords": [
    "immogestion",
    "real-estate",
    "leasing",
    "quebec",
    "api",
    "automation"
  ],
  "author": "Christopher Maltais",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.1",
    "drizzle-orm": "0.45.2",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.5",
    "pg": "^8.11.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^4.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/imrightguy/ImmoGestion.git"
  },
  "bugs": {
    "url": "https://github.com/imrightguy/ImmoGestion/issues"
  },
  "homepage": "https://github.com/imrightguy/ImmoGestion#readme"
}
