# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgres://postgres:***@localhost:5432/immogestion

# JWT
JWT_SECRET=change...ring
JWT_REFRESH_SECRET=***
JWT_EXPIRES_IN=24h

# Twilio (Phase 2)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Simon's phone (for escalation notifications)
SIMON_PHONE=

# Facebook (Phase 3)
FB_PAGE_ACCESS_TOKEN=***
FB_VERIFY_TOKEN=***

# Email (Phase 4)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# App
APP_URL=https://app.immogestion.ca
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional
BCRYPT_ROUNDS=12
LOG_LEVEL=info
