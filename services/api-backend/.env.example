# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgres://user:password@localhost:5432/immogestion

# Auth
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

# App URLs
APP_URL=https://app.immogestion.ca
PAPERCLIP_PUBLIC_URL=
PUBLIC_URL=

# SMTP (Email)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Simon (owner notifications)
SIMON_PHONE=
