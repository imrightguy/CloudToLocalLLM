# ── ImmoGestion Environment Variables ─────────────────────────────────
# Copy this to .env for development or .env.production for production
# NEVER commit .env or .env.production files
# ──────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/immogestion
DB_SSL=false
# DB_SSL=true  (enable for managed cloud DBs)

# ── JWT (REQUIRED — use strong secrets in production, min 32 chars) ───
JWT_SECRET=change-me-to-a-strong-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-strong-random-string
JWT_EXPIRES_IN=24h

# ── Twilio (SMS notifications) ────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SIMON_PHONE=

# ── Facebook Messenger (Phase 3) ─────────────────────────────────────
FB_PAGE_ACCESS_TOKEN=
FB_VERIFY_TOKEN=

# ── Email (SMTP) ─────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@immogestion.ca

# ── App URLs ──────────────────────────────────────────────────────────
APP_URL=https://app.immogestion.ca
PUBLIC_URL=https://app.immogestion.ca
PAPERCLIP_PUBLIC_URL=
# Comma-separated list of allowed origins (NO wildcard in production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Security ──────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Cloudflare Tunnel (production only) ───────────────────────────────
# CLOUDFLARE_TUNNEL_TOKEN=
