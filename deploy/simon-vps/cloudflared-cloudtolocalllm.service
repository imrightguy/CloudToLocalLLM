[Unit]
Description=cloudflared CloudToLocalLLM tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/cloudflared --config /etc/cloudflared/cloudtolocalllm.yml tunnel run --token-file /etc/cloudflared/62da6c19-947b-4bf6-acad-100a73de4e0d.token
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
