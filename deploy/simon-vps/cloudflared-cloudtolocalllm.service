[Unit]
Description=Cloudflare Tunnel for CloudToLocalLLM
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/default/cloudflared-cloudtolocalllm
ExecStart=/bin/sh -lc 'exec /usr/local/bin/cloudflared tunnel --no-autoupdate run --token "$TUNNEL_TOKEN"'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
